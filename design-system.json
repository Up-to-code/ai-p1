{
  "meta": {
    "name": "Qentrah OS Design System",
    "version": "1.1.0",
    "philosophy": "Communication First — every component feels like a node in a communication network. Apple-like minimalism with invisible complexity.",
    "keywords": ["communication", "orchestration", "systems", "agents", "minimalism", "apple-like", "calm technology", "invisible complexity"]
  },
  "colors": {
    "light": {
      "background": "#FAF8F4",
      "surface": "#FFFFFF",
      "surfaceAlt": "#F5F2EC",
      "surfaceTertiary": "#EFEAE2",
      "sidebar": "#F5F2EC",
      "border": "#DED8CF",
      "borderStrong": "#D5CEC4",
      "primary": "#111111",
      "primaryHover": "#222222",
      "primaryPressed": "#000000",
      "success": "#5F7768",
      "warning": "#B78544",
      "danger": "#A55B52",
      "info": "#4388FF",
      "text": "#111111",
      "textSecondary": "#4D4D4D",
      "textMuted": "#787878",
      "networkBlue": "#4F80FF",
      "agentPurple": "#8A5CFF",
      "humanGreen": "#2BB673",
      "automationOrange": "#FF9A3D",
      "dataCyan": "#00A3FF",
      "systemGray": "#5D6570"
    },
    "dark": {
      "background": "#080808",
      "surface": "#1C1C1C",
      "surfaceAlt": "#111111",
      "surfaceTertiary": "#1C1C1C",
      "sidebar": "#222222",
      "border": "#222222",
      "borderStrong": "#2A2A2A",
      "primary": "#F5F2EC",
      "primaryHover": "#EFEAE2",
      "primaryPressed": "#DED8CF",
      "success": "#7F9987",
      "warning": "#D4A56C",
      "danger": "#C5776D",
      "info": "#5B9CFF",
      "text": "#F5F2EC",
      "textSecondary": "#BFB8AE",
      "textMuted": "#8A857E",
      "networkBlue": "#4F80FF",
      "agentPurple": "#8A5CFF",
      "humanGreen": "#2BB673",
      "automationOrange": "#FF9A3D",
      "dataCyan": "#00A3FF",
      "systemGray": "#5D6570"
    }
  },
  "foundation": {
    "grid": {
      "baseUnit": 8,
      "maxContentWidth": "1440px",
      "spacingScale": [2, 4, 8, 12, 16, 20, 24, 32, 40, 48, 56, 64, 80, 96, 128]
    },
    "radius": {
      "none": 0, "xs": 4, "sm": 6, "md": 8, "lg": 10, "xl": 12, "2xl": 16, "3xl": 20, "4xl": 24, "pill": 999
    },
    "borderWidth": {
      "thin": 1, "medium": 2
    },
    "opacity": {
      "disabled": 0.4, "muted": 0.6, "secondary": 0.8, "full": 1
    }
  },
  "layout": {
    "sidebar": { "width": "280px", "collapsed": "72px", "itemHeight": "40px", "itemPadding": "14px", "gap": "12px" },
    "navbar": { "height": "64px", "paddingX": "24px", "gap": "16px" },
    "buttons": { "small": "32px", "medium": "40px", "large": "48px", "paddingX": "16px", "gap": "8px", "radius": "10px" },
    "inputs": { "height": "40px", "padding": "16px", "radius": "10px" },
    "cards": { "padding": "24px", "gap": "20px", "radius": "12px" },
    "modal": { "width": "720px", "padding": "32px", "radius": "16px" },
    "table": { "header": "48px", "row": "52px", "cellPadding": "16px" },
    "badge": { "height": "24px", "paddingX": "10px", "radius": "999px" },
    "avatar": [24, 32, 40, 48],
    "icons": [16, 18, 20, 24]
  },
  "elevation": {
    "sm": { "blur": 8, "y": 2, "spread": 0, "opacity": 0.06 },
    "md": { "blur": 24, "y": 8, "spread": 0, "opacity": 0.08 },
    "lg": { "blur": 48, "y": 16, "spread": 0, "opacity": 0.12 }
  },
  "motion": {
    "duration": { "fast": 150, "normal": 200, "slow": 300 },
    "easing": { "default": "cubic-bezier(0.22,1,0.36,1)", "smooth": "cubic-bezier(0.16,1,0.3,1)" }
  },
  "typography": {
    "fontFamily": { "primary": "Inter", "mono": "JetBrains Mono" },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "sizes": {
      "displayXL": 72, "displayLG": 56, "displayMD": 48, "displaySM": 40,
      "headingXL": 36, "headingLG": 30, "headingMD": 24, "headingSM": 20,
      "bodyLG": 18, "bodyMD": 16, "bodySM": 14, "caption": 13, "tiny": 12
    },
    "lineHeights": { "tight": 1.1, "normal": 1.4, "relaxed": 1.6 }
  }
}
