{
  "meta": {
    "name": "Qentrah OS Design System",
    "version": "1.0.0",
    "philosophy": "Communication First — every component feels like a node in a communication network. Apple-like minimalism with invisible complexity.",
    "keywords": ["communication", "orchestration", "systems", "agents", "minimalism", "apple-like", "calm technology", "invisible complexity"]
  },
  "colors": {
    "light": {
      "background": "#FAF8F4",
      "surface": "#FFFFFF",
      "surfaceSecondary": "#F5F2EC",
      "surfaceTertiary": "#EFEAE2",
      "textPrimary": "#111111",
      "textSecondary": "#4D4D4D",
      "textMuted": "#787878",
      "border": "#DED8CF",
      "borderStrong": "#D5CEC4",
      "primary": "#111111",
      "primaryHover": "#222222",
      "primaryPressed": "#000000",
      "success": "#5F7768",
      "warning": "#B78544",
      "danger": "#A55B52",
      "info": "#4388FF",
      "networkBlue": "#4F80FF",
      "agentPurple": "#8A5CFF",
      "humanGreen": "#2BB673",
      "automationOrange": "#FF9A3D",
      "dataCyan": "#00A3FF",
      "systemGray": "#5D6570"
    },
    "dark": {
      "background": "#0E0E0E",
      "surface": "#161616",
      "surfaceSecondary": "#1F1F1F",
      "surfaceTertiary": "#262626",
      "textPrimary": "#F5F2EC",
      "textSecondary": "#BFB8AE",
      "textMuted": "#8A857E",
      "border": "#2C2C2C",
      "borderStrong": "#3A3A3A",
      "primary": "#F5F2EC",
      "primaryHover": "#EFEAE2",
      "primaryPressed": "#DED8CF",
      "success": "#7F9987",
      "warning": "#D4A56C",
      "danger": "#C5776D",
      "info": "#5B9CFF"
    }
  },
  "cssTokens": {
    "light": {
      "--q-bg": "#FAF8F4",
      "--q-bg-secondary": "#F5F2EC",
      "--q-bg-tertiary": "#EFEAE2",
      "--q-sidebar": "#F5F2EC",
      "--q-topbar": "#FAF8F4",
      "--q-card": "#FFFFFF",
      "--q-border": "#DED8CF",
      "--q-border-strong": "#D5CEC4",
      "--q-text-primary": "#111111",
      "--q-text-secondary": "#4D4D4D",
      "--q-text-muted": "#787878",
      "--q-accent": "#111111",
      "--q-accent-hover": "#222222",
      "--q-accent-active": "#000000",
      "--q-topbar-btn": "#111111"
    },
    "dark": {
      "--q-bg": "#0E0E0E",
      "--q-bg-secondary": "#1F1F1F",
      "--q-bg-tertiary": "#262626",
      "--q-sidebar": "#161616",
      "--q-topbar": "#0E0E0E",
      "--q-card": "#161616",
      "--q-border": "#2C2C2C",
      "--q-border-strong": "#3A3A3A",
      "--q-text-primary": "#F5F2EC",
      "--q-text-secondary": "#BFB8AE",
      "--q-text-muted": "#8A857E",
      "--q-accent": "#F5F2EC",
      "--q-accent-hover": "#EFEAE2",
      "--q-accent-active": "#DED8CF",
      "--q-topbar-btn": "#F5F2EC"
    },
    "status": {
      "--q-success": "#5F7768",
      "--q-warning": "#B78544",
      "--q-error": "#A55B52",
      "--q-info": "#4388FF",
      "--q-note": "#8A5CFF"
    },
    "domain": {
      "--q-network-blue": "#4F80FF",
      "--q-agent-purple": "#8A5CFF",
      "--q-human-green": "#2BB673",
      "--q-automation-orange": "#FF9A3D",
      "--q-data-cyan": "#00A3FF",
      "--q-system-gray": "#5D6570"
    }
  },
  "foundation": {
    "grid": {
      "baseUnit": 4,
      "spacingScale": {
        "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20,
        "6": 24, "7": 28, "8": 32, "10": 40, "12": 48,
        "16": 64, "20": 80, "24": 96
      }
    },
    "radius": {
      "none": 0, "xs": 6, "sm": 10, "md": 14, "lg": 18,
      "xl": 24, "2xl": 32, "3xl": 40, "pill": 9999
    },
    "borderWidth": {
      "thin": 1, "regular": 1.5, "medium": 2, "heavy": 3
    },
    "opacity": {
      "disabled": 0.4, "muted": 0.65, "secondary": 0.8, "full": 1
    }
  },
  "elevation": {
    "sm": { "blur": 12, "y": 4, "spread": 0, "opacity": 0.04 },
    "md": { "blur": 24, "y": 8, "spread": 0, "opacity": 0.08 },
    "lg": { "blur": 48, "y": 16, "spread": 0, "opacity": 0.12 }
  },
  "motion": {
    "duration": {
      "instant": 80, "fast": 150, "normal": 250, "slow": 400, "slower": 700
    },
    "easing": {
      "default": "cubic-bezier(0.22,1,0.36,1)",
      "smooth": "cubic-bezier(0.16,1,0.3,1)"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "SF Pro Display",
      "secondary": "Inter",
      "mono": "SF Mono"
    },
    "weights": {
      "regular": 400, "medium": 500, "semibold": 600, "bold": 700
    },
    "sizes": {
      "displayXL": 96, "displayLG": 72, "displayMD": 56, "displaySM": 48,
      "headingXL": 40, "headingLG": 32, "headingMD": 28, "headingSM": 24,
      "bodyLG": 18, "bodyMD": 16, "bodySM": 14, "caption": 12
    },
    "lineHeights": {
      "tight": 1.05, "normal": 1.4, "relaxed": 1.7
    }
  }
}
