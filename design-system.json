{
  "meta": {
    "name": "Qentrah OS Design System",
    "version": "2.0.0",
    "philosophy": "Communication First — every component feels like a node in a communication network. Apple-like minimalism with invisible complexity.",
    "keywords": ["communication", "orchestration", "systems", "agents", "minimalism", "apple-like", "calm technology", "invisible complexity"]
  },
  "colors": {
    "light": {
      "background": "#FAF8F4",
      "surface": "#FFFFFF",
      "surfaceAlt": "#F5F2EC",
      "surfaceTertiary": "#EFEAE2",
      "sidebar": "#F5F2EC",
      "border": "#DED8CF",
      "borderStrong": "#D5CEC4",
      "primary": "#111111",
      "primaryHover": "#222222",
      "primaryPressed": "#000000",
      "success": "#5F7768",
      "warning": "#B78544",
      "danger": "#A55B52",
      "info": "#4388FF",
      "text": "#111111",
      "textSecondary": "#4D4D4D",
      "textMuted": "#787878",
      "networkBlue": "#4F80FF",
      "agentPurple": "#8A5CFF",
      "humanGreen": "#2BB673",
      "automationOrange": "#FF9A3D",
      "dataCyan": "#00A3FF",
      "systemGray": "#5D6570"
    },
    "dark": {
      "background": "#080808",
      "surface": "#1C1C1C",
      "surfaceAlt": "#111111",
      "surfaceTertiary": "#1C1C1C",
      "sidebar": "#222222",
      "border": "#222222",
      "borderStrong": "#2A2A2A",
      "primary": "#F5F2EC",
      "primaryHover": "#EFEAE2",
      "primaryPressed": "#DED8CF",
      "success": "#7F9987",
      "warning": "#D4A56C",
      "danger": "#C5776D",
      "info": "#5B9CFF",
      "text": "#F5F2EC",
      "textSecondary": "#BFB8AE",
      "textMuted": "#8A857E",
      "networkBlue": "#4F80FF",
      "agentPurple": "#8A5CFF",
      "humanGreen": "#2BB673",
      "automationOrange": "#FF9A3D",
      "dataCyan": "#00A3FF",
      "systemGray": "#5D6570"
    },
    "status": {
      "todo":        { "hue": "zinc",    "light": { "bg": "#F3F3F3", "text": "#555555", "dot": "#BBBBBB" }, "dark": { "bg": "rgba(113,113,113,0.12)", "text": "#A1A1A1", "dot": "#888888" } },
      "inProgress":  { "hue": "orange",  "light": { "bg": "#FEF0E0", "text": "#B86600", "dot": "#E08C00" }, "dark": { "bg": "rgba(224,140,0,0.12)", "text": "#E08C00", "dot": "#E08C00" } },
      "waiting":     { "hue": "purple",  "light": { "bg": "#F5F0FF", "text": "#6837C0", "dot": "#8855E0" }, "dark": { "bg": "rgba(136,85,224,0.12)", "text": "#A880E8", "dot": "#8855E0" } },
      "done":        { "hue": "emerald", "light": { "bg": "#E4F7ED", "text": "#17803F", "dot": "#1A8A45" }, "dark": { "bg": "rgba(26,138,69,0.12)", "text": "#3CB872", "dot": "#1A8A45" } },
      "canceled":    { "hue": "rose",    "light": { "bg": "#FCE9E9", "text": "#B02020", "dot": "#D93232" }, "dark": { "bg": "rgba(217,50,50,0.12)", "text": "#E55A5A", "dot": "#D93232" } }
    },
    "priority": {
      "urgent":  { "hue": "rose",    "light": { "bg": "#FCE9E9", "text": "#B02020", "icon": "#D93232" }, "dark": { "bg": "rgba(217,50,50,0.12)", "text": "#E55A5A", "icon": "#D93232" } },
      "high":    { "hue": "rose",    "light": { "bg": "#FCE9E9", "text": "#B02020", "icon": "#D93232" }, "dark": { "bg": "rgba(217,50,50,0.12)", "text": "#E55A5A", "icon": "#D93232" } },
      "normal":  { "hue": "amber",   "light": { "bg": "#FFF8E0", "text": "#9A6A00", "icon": "#E0A800" }, "dark": { "bg": "rgba(224,168,0,0.12)", "text": "#E0B438", "icon": "#E0A800" } },
      "low":     { "hue": "emerald", "light": { "bg": "#E4F7ED", "text": "#17803F", "icon": "#1A8A45" }, "dark": { "bg": "rgba(26,138,69,0.12)", "text": "#3CB872", "icon": "#1A8A45" } }
    }
  },
  "foundation": {
    "grid": {
      "baseUnit": 8,
      "maxContentWidth": "1440px",
      "spacingScale": [2, 4, 8, 12, 16, 20, 24, 32, 40, 48, 56, 64, 80, 96, 128]
    },
    "radius": {
      "none": 0, "xs": 4, "sm": 6, "md": 8, "lg": 10, "xl": 12, "2xl": 16, "3xl": 20, "4xl": 24, "pill": 999
    },
    "borderWidth": {
      "thin": 1, "medium": 2
    },
    "opacity": {
      "disabled": 0.4, "muted": 0.6, "secondary": 0.8, "full": 1
    }
  },
  "layout": {
    "sidebar": { "width": "280px", "collapsed": "72px", "itemHeight": "40px", "itemPadding": "14px", "gap": "12px" },
    "navbar": { "height": "64px", "paddingX": "24px", "gap": "16px" },
    "buttons": { "small": "32px", "medium": "40px", "large": "48px", "paddingX": "16px", "gap": "8px", "radius": "10px" },
    "inputs": { "height": "40px", "padding": "16px", "radius": "10px" },
    "cards": { "padding": "24px", "gap": "20px", "radius": "12px" },
    "modal": { "width": "720px", "padding": "32px", "radius": "16px" },
    "table": { "header": "48px", "row": "52px", "cellPadding": "16px" },
    "badge": { "height": "24px", "paddingX": "10px", "radius": "999px" },
    "avatar": [24, 32, 40, 48],
    "icons": [16, 18, 20, 24]
  },
  "elevation": {
    "sm": { "blur": 8, "y": 2, "spread": 0, "opacity": 0.06 },
    "md": { "blur": 24, "y": 8, "spread": 0, "opacity": 0.08 },
    "lg": { "blur": 48, "y": 16, "spread": 0, "opacity": 0.12 }
  },
  "motion": {
    "duration": { "fast": 150, "normal": 200, "slow": 300 },
    "easing": { "default": "cubic-bezier(0.22,1,0.36,1)", "smooth": "cubic-bezier(0.16,1,0.3,1)" }
  },
  "typography": {
    "fontFamily": { "primary": "Inter", "mono": "JetBrains Mono", "arabic": "Tajawal" },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "sizes": {
      "displayXL": 72, "displayLG": 56, "displayMD": 48, "displaySM": 40,
      "headingXL": 36, "headingLG": 30, "headingMD": 24, "headingSM": 20,
      "bodyLG": 18, "bodyMD": 16, "bodySM": 14, "caption": 13, "tiny": 12
    },
    "lineHeights": { "tight": 1.1, "normal": 1.4, "relaxed": 1.6 }
  },
  "cssVariables": {
    "description": "All components must use var(--q-*) tokens. Never hardcode Tailwind color utilities like bg-violet-500. Status and priority colors are defined as --q-status-{name} and --q-priority-{name} with -bg, -text, -dot suffixes.",
    "statusTokens": ["--q-status-todo", "--q-status-inProgress", "--q-status-waiting", "--q-status-done", "--q-status-canceled"],
    "priorityTokens": ["--q-priority-urgent", "--q-priority-high", "--q-priority-normal", "--q-priority-low"],
    "suffixes": ["", "-bg", "-text", "-dot", "-border", "-icon"]
  }
}
