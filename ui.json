      "warning": { "value": "#B78544", "dark": "#D4A56C", "css": "--q-warning", "note": "In review / queued" },
      "error":   { "value": "#A55B52", "dark": "#C5776D", "css": "--q-error",   "note": "Blocked / failed / destructive" },
      "info":    { "value": "#4388FF", "dark": "#5B9CFF", "css": "--q-info",    "note": "In progress" },
      "note":    { "value": "#8A5CFF", "dark": "#8A5CFF", "css": "--q-note",    "note": "Draft / neutral" }
    },
    "domain": {
      "networkBlue":       { "value": "#4F80FF", "css": "--q-network-blue",       "note": "Network connections, links" },
      "agentPurple":       { "value": "#8A5CFF", "css": "--q-agent-purple",       "note": "Agent nodes, AI elements" },
