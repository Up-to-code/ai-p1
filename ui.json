  "typography": {
    "fontSans":         { "value": "Inter, SF Pro Display, -apple-system, BlinkMacSystemFont, sans-serif" },
    "fontDisplay":      { "value": "SF Pro Display, Inter, -apple-system, BlinkMacSystemFont, sans-serif" },
    "fontMono":         { "value": "SF Mono, JetBrains Mono, ui-monospace, Menlo, Monaco, Consolas, monospace" },
    "letterSpacing":    { "value": "-0.03em", "note": "Apple-style tight tracking on body" },
    "letterSpacingRtl": { "value": "0",       "note": "Arabic / RTL — no tracking" }
  },
  "radius": {
    "none": "0px",
    "xs":   "6px",
    "sm":   "10px",
    "md":   "14px",
    "lg":   "18px",
    "xl":   "24px",
    "2xl":  "32px",
    "3xl":  "40px",
    "pill": "9999px"
  },
  "elevation": {
    "sm": "0 4px 12px rgba(0, 0, 0, 0.04)",
    "md": "0 8px 24px rgba(0, 0, 0, 0.08)",
    "lg": "0 16px 48px rgba(0, 0, 0, 0.12)"
  },
  "motion": {
    "duration": {
      "instant": "80ms", "fast": "150ms", "normal": "250ms", "slow": "400ms", "slower": "700ms"
    },
    "easing": {
      "default": "cubic-bezier(0.22, 1, 0.36, 1)",
      "smooth": "cubic-bezier(0.16, 1, 0.3, 1)"
    }
  },
  "layout": {
    "sidebarWidth":   "280px",
    "topbarHeight":   "72px",
    "contentPadding": "24px",
    "cardGap":        "20px"
  },
  "principles": {
    "communicationFirst": "Every component feels like a node in a communication network. Agents, humans, data, and automation are visualized as connected entities.",
    "appleMinimalism": "Near-black primary in light mode, pure white in dark. Warm off-white backgrounds. Extreme restraint in decoration.",
    "calmTechnology": "Invisible complexity. The interface recedes, letting the communication and orchestration take center stage.",
    "domainColors": "Six domain colors for network, agent, human, automation, data, and system — enabling visual language for the communication graph."
  }
}
