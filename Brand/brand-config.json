{
  "name": "Qentrah Brand",
  "version": "1.0.0",
  "logo": {
    "light": {
      "file": "@logo-blank.svg",
      "viewBox": "0 0 901 1033",
      "fill": "black",
      "description": "Brand logo — black fill for light backgrounds"
    },
    "dark": {
      "file": "@logo-white.svg",
      "viewBox": "0 0 901 1033",
      "fill": "white",
      "description": "Brand logo — white fill for dark backgrounds"
    }
  },
  "icon": {
    "source": "bund/qentrah-icon-ios-rounded.png",
    "canvas": {
      "width": 1024,
      "height": 1024,
      "background": "#FFFFFF",
      "cornerRadius": 230
    }
  },
  "favicon": {
    "ico": "Branding/logo.ico",
    "svg": {
      "description": "White rounded-square background with black brand logo centered",
      "background": "white",
      "logoFill": "black",
      "cornerRadius": 96
    }
  },
  "assets": {
    "sourceDir": "packages/brand-identity/assets/source",
    "apps": {
      "marketing": {
        "public": "apps/marketing/public",
        "assets": {
          "logo.ico": "logo.ico",
          "brand-logo.svg": "logo.light",
          "brand-logo-white.svg": "logo.dark",
          "favicon.svg": "generated/favicon",
          "mask-icon.svg": "generated/mask-icon",
          "app-icon-192.png": "generated/app-icon-192",
          "app-icon-512.png": "generated/app-icon-512",
          "app-icon-1024.png": "generated/app-icon-1024",
          "apple-touch-icon.png": "generated/apple-touch-icon"
        }
      },
      "workspace": {
        "public": "apps/workspace/public",
        "assets": {
          "logo.ico": "logo.ico",
          "brand-logo.svg": "logo.light",
          "brand-logo-white.svg": "logo.dark",
          "favicon.svg": "generated/favicon",
          "mask-icon.svg": "generated/mask-icon",
          "app-icon-192.png": "generated/app-icon-192",
          "app-icon-512.png": "generated/app-icon-512",
          "app-icon-1024.png": "generated/app-icon-1024",
          "apple-touch-icon.png": "generated/apple-touch-icon"
        }
      },
      "partners": {
        "public": "apps/partners/public",
        "assets": {
          "logo.ico": "logo.ico",
          "brand-logo.svg": "logo.light",
          "brand-logo-white.svg": "logo.dark",
          "favicon.svg": "generated/favicon",
          "mask-icon.svg": "generated/mask-icon",
          "app-icon-192.png": "generated/app-icon-192",
          "app-icon-512.png": "generated/app-icon-512",
          "app-icon-1024.png": "generated/app-icon-1024",
          "apple-touch-icon.png": "generated/apple-touch-icon"
        }
      },
      "admin": {
        "public": "apps/admin/public",
        "assets": {
          "logo.ico": "logo.ico",
          "favicon.svg": "generated/favicon",
          "mask-icon.svg": "generated/mask-icon",
          "app-icon-192.png": "generated/app-icon-192",
          "app-icon-512.png": "generated/app-icon-512",
          "app-icon-1024.png": "generated/app-icon-1024",
          "apple-touch-icon.png": "generated/apple-touch-icon"
        }
      },
      "mobile": {
        "assetsDir": "apps/mobile/assets",
        "assets": {
          "brand/qentrah-mobile-icon.png": "icon.source",
          "brand/qentrah-adaptive-icon.png": "icon.source",
          "brand/qentrah-logo.png": "generated/brand-mark-png",
          "brand/qentrah-logo.svg": "generated/brand-mark-svg",
          "brand/qentrah-splash-icon.png": "generated/mobile-splash-light",
          "brand/qentrah-splash-icon-dark.png": "generated/mobile-splash-dark",
          "brand/qentrah-favicon.png": "generated/mobile-favicon",
          "icon.png": "generated/mobile-icon-512",
          "adaptive-icon.png": "generated/mobile-adaptive-icon-512",
          "favicon.png": "generated/mobile-favicon-48",
          "splash-icon.png": "generated/mobile-splash-small"
        }
      }
    }
  },
  "references": {
    "brandConfig": "Brand/brand-config.json",
    "designRules": "Brand/bund/design-rules.json",
    "brandIdentity": "packages/brand-identity/src/index.ts",
    "sourceAssets": "packages/brand-identity/assets/source/",
    "syncScript": "scripts/brand-assets.mjs"
  }
}
