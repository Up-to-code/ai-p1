{
  "name": "@qentrah/workspace",
  "version": "0.1.0",
  "description": "Qentrah Workspace desktop app for real estate operations and partner authorization.",
  "author": "Qentrah",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n next,convex -c cyan,magenta \"next dev\" \"convex dev\"",
    "dev:stack": "concurrently -n next,convex -c cyan,magenta \"next dev\" \"convex dev\"",
    "desktop:dev": "concurrently -n next,convex,electron -c cyan,magenta,blue \"next dev\" \"convex dev\" \"electron .\"",
    "desktop:assets": "node scripts/prepare-desktop-assets.mjs",
    "desktop:build:web": "node scripts/build-desktop-web.mjs",
    "desktop:pack": "npm run desktop:assets && npm run desktop:build:web && electron-builder --dir",
    "desktop:dist": "npm run desktop:assets && npm run desktop:build:web && electron-builder --mac dmg",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:next": "next dev",
    "dev:hono": "next dev",
    "dev:convex": "convex dev",
    "dev:convex:once": "convex dev --once",
    "codegen:convex": "convex codegen",
    "build": "npm --workspace @qentrah/location-map run build && next build && node scripts/ensure-vercel-manifest.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check:convex-runtime": "node scripts/check-convex-runtime.mjs",
    "check:workos-live-prereqs": "node scripts/check-workos-live-prereqs.mjs",
    "test": "vitest run",
    "test:workos-partner-flow": "vitest run src/server/domains/partnerApps/services/workos-partner-flow.test.ts src/server/domains/partnerApps/services/workos-source-hygiene.test.ts src/domains/integrations/integrations-runtime.test.ts src/server/domains/partnerApps convex/workosPartnerApiKeys.ts convex/partnerApps/apps.test.ts convex/partnerResourceGateway.test.ts src/packages/config/workos-secret-hygiene.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@convex-dev/workos": "^0.0.3",
    "@convex-dev/workos-authkit": "^0.2.6",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@number-flow/react": "^0.6.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@qentrah/brand-identity": "0.1.0",
    "@qentrah/convex-adapters": "0.1.0",
    "@qentrah/domain-contracts": "0.1.0",
    "@qentrah/location-map": "^0.1.0",
    "@qentrah/partner-auth-core": "0.1.0",
    "@qentrah/partner-workspace-sync": "0.1.0",
    "@qentrah/platform-core": "0.1.0",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@sentry/nextjs": "^10.52.0",
    "@sentry/profiling-node": "^10.52.0",
    "@tanstack/react-query": "^5.100.9",
    "@untitledui/icons": "^0.0.22",
    "@uploadthing/react": "^7.3.3",
    "@workos-inc/authkit-nextjs": "^4.1.1",
    "@workos-inc/node": "^9.3.1",
    "ai": "^6.0.177",
    "better-call": "^1.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.37.0",
    "convex-api-keys": "^0.2.1",
    "convex-helpers": "^0.1.116",
    "effect": "^3.21.2",
    "fetch-to-node": "^2.1.0",
    "framer-motion": "^12.38.0",
    "hono": "^4.12.18",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "next": "^16.3.0-canary.19",
    "next-intl": "^4.11.0",
    "react": "19.2.4",
    "react-aria-components": "^1.17.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "reaviz": "^16.1.2",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.6.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.1.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "use-stick-to-bottom": "^1.1.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "build": {
    "appId": "com.qentrah.workspace",
    "productName": "Qentrah Workspace",
    "copyright": "Copyright © Qentrah",
    "directories": {
      "output": "dist/desktop"
    },
    "afterPack": "scripts/electron-after-pack.cjs",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "standalone/apps/workspace/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/apps/workspace/public"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": "dmg",
      "identity": null
    },
    "dmg": {
      "title": "Install",
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 118,
          "y": 172,
          "type": "file"
        },
        {
          "x": 544,
          "y": 172,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Office"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
