{
  "name": "@qentrah/workspace",
  "version": "0.1.0",
  "description": "Qentrah Workspace desktop app for workspace operations and partner authorization.",
  "author": "Qentrah",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm --workspace @qentrah/location-map --include-workspace-root=false run build && npm --workspace @qentrah/domain-contracts --include-workspace-root=false run build && concurrently -n next,convex -c cyan,magenta \"next dev\" \"convex dev\"",
    "dev:stack": "concurrently -n next,convex -c cyan,magenta \"next dev\" \"convex dev\"",
    "desktop:dev": "concurrently -n next,convex,electron -c cyan,magenta,blue \"next dev\" \"convex dev\" \"electron .\"",
    "desktop:assets": "node scripts/prepare-desktop-assets.mjs",
    "desktop:build:web": "node scripts/build-desktop-web.mjs",
    "desktop:pack": "npm run desktop:assets && npm run desktop:build:web && electron-builder --dir",
    "desktop:dist": "npm run desktop:assets && npm run desktop:build:web && electron-builder --mac dmg",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:next": "next dev",
    "dev:eve": "eve dev --no-ui --port 55006",
    "dev:hono": "next dev",
    "dev:convex": "convex dev",
    "dev:convex:once": "convex dev --once",
    "codegen:convex": "convex codegen",
    "build": "npm --workspace @qentrah/location-map --include-workspace-root=false run build && npm --workspace @qentrah/mcp-contracts --include-workspace-root=false run build && npm --workspace @qentrah/our-platform-components --include-workspace-root=false run build && npm --workspace @qentrah/ui --include-workspace-root=false run build && next build && node scripts/ensure-vercel-manifest.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check:convex-runtime": "node scripts/check-convex-runtime.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@base-ui/react": "^1.4.1",
    "@better-auth/expo": "^1.6.23",
    "@better-auth/i18n": "^1.6.23",
    "@better-auth/oauth-provider": "^1.6.23",
    "@convex-dev/better-auth": "^0.12.2",
    "@convex-dev/expo-push-notifications": "0.3.1",
    "@convex-dev/resend": "^0.2.5",
    "@dodopayments/convex": "^0.2.12",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@number-flow/react": "^0.6.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@qentrah/auth": "0.1.0",
    "@qentrah/brand-identity": "0.1.0",
    "@qentrah/domain-contracts": "0.1.0",
    "@qentrah/location-map": "^0.1.0",
    "@qentrah/mcp-contracts": "0.1.0",
    "@qentrah/partner-auth-core": "0.1.0",
    "@qentrah/partner-workspace-sync": "0.1.0",
    "@qentrah/platform-core": "0.1.0",
    "@qentrah/ui": "0.1.0",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@sentry/nextjs": "^10.52.0",
    "@sentry/profiling-node": "^10.52.0",
    "@svar-ui/react-calendar": "^2.6.2",
    "@svar-ui/react-kanban": "^2.6.0",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-task-item": "^3.27.3",
    "@tiptap/extension-task-list": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/extensions": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@vercel/analytics": "^1.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.11.2",
    "@yoopta/accordion": "^6.0.5",
    "@yoopta/blockquote": "^6.0.5",
    "@yoopta/callout": "^6.0.5",
    "@yoopta/carousel": "^6.0.5",
    "@yoopta/code": "^6.0.5",
    "@yoopta/divider": "^6.0.5",
    "@yoopta/editor": "^6.0.5",
    "@yoopta/embed": "^6.0.5",
    "@yoopta/emoji": "^6.0.5",
    "@yoopta/exports": "^6.0.5",
    "@yoopta/file": "^6.0.5",
    "@yoopta/headings": "^6.0.5",
    "@yoopta/image": "^6.0.5",
    "@yoopta/link": "^6.0.5",
    "@yoopta/lists": "^6.0.5",
    "@yoopta/marks": "^6.0.5",
    "@yoopta/math": "^6.0.5",
    "@yoopta/mention": "^6.0.5",
    "@yoopta/paragraph": "^6.0.5",
    "@yoopta/steps": "^6.0.5",
    "@yoopta/table": "^6.0.5",
    "@yoopta/table-of-contents": "^6.0.5",
    "@yoopta/tabs": "^6.0.5",
    "@yoopta/themes-shadcn": "^6.0.5",
    "@yoopta/ui": "^6.0.5",
    "@yoopta/video": "^6.0.5",
    "better-auth": "~1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.37.0",
    "convex-api-keys": "^0.2.1",
    "date-arithmetic": "^4.1.0",
    "date-fns": "^4.4.0",
    "effect": "^3.21.2",
    "extend": "^3.0.0",
    "framer-motion": "^12.38.0",
    "gridstack": "^12.6.0",
    "gsap": "^3.15.0",
    "hono": "^4.12.18",
    "idb": "^8.0.3",
    "is-plain-obj": "^4.0.0",
    "jiti": "^2.7.0",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "micromark-core-commonmark": "^2.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-util-sanitize-uri": "^2.0.0",
    "moment": "^2.30.1",
    "next": "^16.3.0-canary.32",
    "next-intl": "^4.11.0",
    "notion-types": "^7.10.0",
    "notion-utils": "^7.10.0",
    "prosemirror-model": "^1.25.7",
    "react": "19.2.3",
    "react-aria-components": "^1.17.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "react-notion-x": "^7.10.0",
    "react-resizable-panels": "^4.11.2",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.6.0",
    "shiki": "^4.0.2",
    "slate": "^0.120.0",
    "slate-dom": "^0.119.0",
    "slate-react": "^0.120.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unist-util-stringify-position": "^4.0.0",
    "uploadthing": "^7.7.4",
    "victory-vendor": "^37.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13",
    "zwitch": "^2.0.0"
  },
  "build": {
    "appId": "com.qentrah.workspace",
    "productName": "Qentrah Workspace",
    "copyright": "Copyright © Qentrah",
    "directories": {
      "output": "dist/desktop"
    },
    "afterPack": "scripts/electron-after-pack.cjs",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "standalone/apps/workspace/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/apps/workspace/public"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "target": "dmg",
      "identity": null
    },
    "dmg": {
      "title": "Install",
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 118,
          "y": 172,
          "type": "file"
        },
        {
          "x": 544,
          "y": 172,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Office"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "happy-dom": "^20.10.6",
    "microsandbox": "^0.6.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
