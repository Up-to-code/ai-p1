{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@qentrah/auth": ["../../packages/auth/src/index.ts"],
      "@qentrah/auth/client": ["../../packages/auth/src/client/index.ts"],
      "@qentrah/auth/react": ["../../packages/auth/src/react/index.ts"],
      "@qentrah/auth/scopes": ["../../packages/auth/src/scopes/index.ts"],
      "@qentrah/auth/server": ["../../packages/auth/src/server/index.ts"],
      "@qentrah/brand-identity": ["../../packages/brand-identity/src/index.ts"],
      "@qentrah/domain-contracts": ["../../packages/domain-contracts/src/index.ts"],
      "@qentrah/domain-contracts/subscription-pricing": ["../../packages/domain-contracts/src/subscriptionPricing.ts"],
      "@qentrah/partner-auth-core": ["../../packages/partner-auth-core/src/index.ts"],
      "@qentrah/partner-workspace-sync": ["../../packages/partner-workspace-sync/src/index.ts"],
      "@qentrah/platform-core/auth-next": ["../../packages/platform-core/src/auth-next.ts"],
      "@qentrah/platform-core/classnames": ["../../packages/platform-core/src/classnames.ts"],
      "@qentrah/platform-core/convex-api": ["../../packages/platform-core/src/convex-api.ts"],
      "@qentrah/platform-core/effect-api": ["../../packages/platform-core/src/effect-api.ts"],
      "@qentrah/platform-core/errors": ["../../packages/platform-core/src/errors.ts"],
      "@qentrah/platform-core/locale": ["../../packages/platform-core/src/locale.ts"],
      "@qentrah/platform-core/session": ["../../packages/platform-core/src/session.ts"],
      "@qentrah/platform-core": ["../../packages/platform-core/src/index.ts"],
      "@qentrah/ui": ["../../packages/ui/src/index.ts"],
      "@/*": ["./src/*"],
      "@convex/*": ["./convex/*"],
      "next": ["./node_modules/next"],
      "next/*": ["./node_modules/next/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
