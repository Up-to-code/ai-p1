{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@qentrah/auth": ["../../packages/auth/src/index.ts"],
      "@qentrah/brand-identity": ["../../packages/brand-identity/src/index.ts"],
      "@qentrah/convex-adapters": ["../../packages/convex-adapters/src/index.ts"],
      "@qentrah/domain-contracts": ["../../packages/domain-contracts/src/index.ts"],
      "@qentrah/domain-contracts/subscription-pricing": ["../../packages/domain-contracts/src/subscriptionPricing.ts"],
      "@qentrah/partner-auth-core": ["../../packages/partner-auth-core/src/index.ts"],
      "@qentrah/partner-workspace-sync": ["../../packages/partner-workspace-sync/src/index.ts"],
      "@qentrah/platform-core/convex-api": ["../../packages/platform-core/src/convex-api.ts"],
      "@qentrah/platform-core/effect-api": ["../../packages/platform-core/src/effect-api.ts"],
      "@qentrah/platform-core": ["../../packages/platform-core/src/index.ts"],
      "@/*": ["./src/*"],
      "@convex/*": ["./convex/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
