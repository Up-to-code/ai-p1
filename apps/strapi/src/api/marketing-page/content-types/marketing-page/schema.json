{
  "kind": "collectionType",
  "collectionName": "marketing_pages",
  "info": {
    "singularName": "marketing-page",
    "pluralName": "marketing-pages",
    "displayName": "Marketing Page",
    "description": "CMS-driven marketing pages (home, pricing, about, etc.)"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "pageType": {
      "type": "enumeration",
      "enum": ["home", "pricing", "about", "contact", "docs", "generic"],
      "required": true,
      "default": "generic"
    },
    "excerpt": { "type": "text" },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.feature-grid",
        "sections.image-text",
        "sections.cta-section",
        "sections.stats",
        "sections.testimonial",
        "sections.rich-text"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
