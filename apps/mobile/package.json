{
  "name": "@zane-ai/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "agent:worker": "tsx ../../scripts/agent-worker.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:size": "node ./scripts/mobile-size-audit.mjs",
    "test": "tsx --test src/tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "convex:dev": "node ./scripts/runConvexDev.mjs",
    "convex:codegen": "CI=1 npx convex codegen && node ./scripts/syncConvexGenerated.mjs",
    "convex:sync-generated": "node ./scripts/syncConvexGenerated.mjs",
    "maestro:test": "maestro test .maestro/flows",
    "maestro:smoke": "maestro test .maestro/flows"
  },
  "dependencies": {
    "@better-auth/expo": "1.5.6",
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@google/genai": "^1.48.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@rnmapbox/maps": "^10.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.35.1",
    "expo": "54.0.33",
    "expo-clipboard": "^55.0.13",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
