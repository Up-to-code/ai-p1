    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^20.17.15",
    "@types/react": "^19.2.14",
    "babel-preset-expo": "~54.0.6",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.13",
    "react-test-renderer": "19.1.0",
