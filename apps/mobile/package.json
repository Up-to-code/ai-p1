{
  "name": "@qentrah/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "QENTRAH_MOBILE_ENV=development npx expo start --clear --max-workers 1",
    "start:production": "QENTRAH_MOBILE_ENV=production npx expo start --clear --max-workers 1",
    "android": "QENTRAH_MOBILE_ENV=development npx expo run:android",
    "ios": "QENTRAH_MOBILE_ENV=development npx expo run:ios",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:size": "node ./scripts/mobile-size-audit.mjs",
    "test": "tsx --test src/tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "maestro:test": "maestro test .maestro/flows",
    "maestro:smoke": "maestro test .maestro/flows"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "@solana-mobile/mobile-wallet-adapter-protocol",
          "expo-modules-jsi",
          "react-native-fs"
        ],
        "listUnknownPackages": true
      }
    }
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.23",
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.1",
    "@expo/metro-runtime": "~56.0.13",
    "@expo/ui": "~56.0.15",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/flash-list": "2.0.2",
    "better-auth": "~1.6.9",
    "expo-network": "~8.0.8",
    "expo": "^56.0.0",
    "expo-apple-authentication": "~56.0.4",
    "expo-auth-session": "~57.0.5",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.9",
    "expo-linking": "~56.0.13",
    "expo-notifications": "~0.32.17",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-speech-recognition": "^56.0.0",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "lucide-react-native": "^0.542.0",
    "merge-options": "^3.0.4",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-hapticlabs": "^0.10.3",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^3.4.17",
    "uploadthing": "^7.7.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^20.17.15",
    "@types/react": "^19.2.14",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.4",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3"
  }
}
