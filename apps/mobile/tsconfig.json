{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "baseUrl": ".",
    "types": [
      "jest",
      "node",
      "nativewind/types"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@convex/*": [
        "./src/persistence/convex/*",
        "../../convex/*"
      ],
      "@zayon/assistant-protocol": [
        "./src/conversation/assistantProtocol.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
