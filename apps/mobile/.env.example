# Expo runtime values for the mobile app.
# development: Workspace API by default; override with a LAN URL only for local backend testing.
# production: App Store/TestFlight release URLs.
QENTRAH_MOBILE_ENV=development

EXPO_PUBLIC_AUTH_URL=
EXPO_PUBLIC_WORKSPACE_API_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional development overrides.
EXPO_PUBLIC_DEV_WORKSPACE_API_URL=https://app.qentrah.com
EXPO_PUBLIC_DEV_AUTH_URL=https://app.qentrah.com
EXPO_PUBLIC_DEV_CLERK_PUBLISHABLE_KEY=

EXPO_PUBLIC_PRODUCTION_WORKSPACE_API_URL=https://app.qentrah.com
EXPO_PUBLIC_PRODUCTION_AUTH_URL=https://app.qentrah.com
EXPO_PUBLIC_PRODUCTION_CLERK_PUBLISHABLE_KEY=
