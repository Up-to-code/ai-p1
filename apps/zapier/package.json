  },
  "dependencies": {
    "zapier-platform-core": "19.0.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "typescript": "5.6.2",
    "vitest": "^2.1.2",
    "zapier-platform-cli": "19.0.0"
  },
  "private": true,
  "exports": "./dist/index.js",
  "type": "module"
}
