{
  "name": "@qentrah/zapier-app",
  "version": "1.0.0",
  "description": "Official Qentrah integration for Zapier Platform.",
  "scripts": {
    "test": "npm run build && vitest --run",
    "clean": "rimraf ./dist ./build",
