generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model PartnerProfile {
  id          String   @id @default(cuid())
  authSubject String   @unique
  name        String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizations        ProgrammerOrganization[]
  apps                 PartnerApp[]
  events               PartnerEvent[]
  sandboxOrganizations SandboxOrganization[]
  sandboxResources     SandboxResource[]
  sandboxOAuthCodes    SandboxOAuthCode[]
  sandboxOAuthTokens   SandboxOAuthToken[]
}

model ProgrammerOrganization {
  id                   String   @id @default(cuid())
  ownerAuthSubject     String   @unique
  tenantOrganizationId String?  @unique
  name                 String
  type                 String   @default("programmer")
  countryCode          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner PartnerProfile @relation(fields: [ownerAuthSubject], references: [authSubject], onDelete: Cascade)
  apps  PartnerApp[]
}

model PartnerApp {
  id                            String   @id @default(cuid())
  partnerAuthSubject            String
  partnerOrganizationId         String?
  clientId                      String   @unique
  clientSecretHash              String?
  name                          String
  publisherName                 String
  homepageUrl                   String?
  iconUrl                       String?
  logoUrl                       String?
  clientType                    String
  redirectUris                  String[]
  allowedScopes                 String[]
  status                        String
  workspacePartnerAppId         String?
  workspaceOauthClientId        String?
  workspaceSyncStatus           String?
  workspaceSyncError            String?
  ananWorkspaceClientId         String?
  authorizationExpiresAfterDays Int
  reviewNotes                   String?
  submittedAt                   DateTime?
  reviewedAt                    DateTime?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  partner              PartnerProfile           @relation(fields: [partnerAuthSubject], references: [authSubject], onDelete: Cascade)
  organization         ProgrammerOrganization?  @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  reviews              PartnerAppReview[]
  events               PartnerEvent[]
  links                AnanWorkspaceLink[]
  sandboxOrganizations SandboxOrganization[]
  sandboxResources     SandboxResource[]
  sandboxOAuthCodes    SandboxOAuthCode[]
  sandboxOAuthTokens   SandboxOAuthToken[]

  @@index([partnerAuthSubject])
  @@index([partnerOrganizationId])
  @@index([status])
}

model SandboxOrganization {
  id                 String   @id @default(cuid())
  partnerAuthSubject String
  partnerAppId       String
  organizationId     String   @unique
  name               String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  partner PartnerProfile @relation(fields: [partnerAuthSubject], references: [authSubject], onDelete: Cascade)
  app     PartnerApp     @relation(fields: [partnerAppId], references: [id], onDelete: Cascade)

  @@index([partnerAppId])
  @@index([partnerAuthSubject])
}

model SandboxOAuthCode {
  id                  String    @id @default(cuid())
  partnerAuthSubject  String
  partnerAppId        String
  organizationId      String
  code                String    @unique
  clientId            String
  redirectUri         String
  scopes              String[]
  codeChallenge       String
  codeChallengeMethod String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  partner PartnerProfile @relation(fields: [partnerAuthSubject], references: [authSubject], onDelete: Cascade)
  app     PartnerApp     @relation(fields: [partnerAppId], references: [id], onDelete: Cascade)

  @@index([partnerAppId])
}

model SandboxOAuthToken {
  id                 String    @id @default(cuid())
  partnerAuthSubject String
  partnerAppId       String
  organizationId     String
  accessTokenHash    String?   @unique
  refreshTokenHash   String?   @unique
  clientId           String
  scopes             String[]
  status             String
  accessExpiresAt    DateTime
  refreshExpiresAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  partner PartnerProfile @relation(fields: [partnerAuthSubject], references: [authSubject], onDelete: Cascade)
  app     PartnerApp     @relation(fields: [partnerAppId], references: [id], onDelete: Cascade)

  @@index([partnerAppId])
}

model SandboxResource {
  id                 String    @id @default(cuid())
  partnerAuthSubject String
  partnerAppId       String
  organizationId     String
  resourceType       String
  data               Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  partner PartnerProfile @relation(fields: [partnerAuthSubject], references: [authSubject], onDelete: Cascade)
  app     PartnerApp     @relation(fields: [partnerAppId], references: [id], onDelete: Cascade)

  @@index([organizationId, resourceType])
  @@index([partnerAppId])
}

model SandboxRequestLog {
  id                 String   @id @default(cuid())
  partnerAuthSubject String?
  partnerAppId       String?
  organizationId     String?
  method             String
  path               String
  status             Int
  latencyMs          Int
  scopes             String[]
  input              Json?
  response           Json?
  error              String?
  createdAt          DateTime @default(now())

  @@index([partnerAppId])
  @@index([organizationId])
}

model PartnerAppReview {
  id                  String   @id @default(cuid())
  appId               String
  status              String
  reviewerAuthSubject String?
  notes               String?
  createdAt           DateTime @default(now())

  app PartnerApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

model PartnerEvent {
  id               String   @id @default(cuid())
  actorAuthSubject String?
  appId            String?
  eventType        String
  payload          Json?
  createdAt        DateTime @default(now())

  actor PartnerProfile? @relation(fields: [actorAuthSubject], references: [authSubject], onDelete: SetNull)
  app   PartnerApp?     @relation(fields: [appId], references: [id], onDelete: SetNull)

  @@index([actorAuthSubject])
  @@index([appId])
  @@index([eventType])
}

model AnanWorkspaceLink {
  id                 String   @id @default(cuid())
  partnerAppId       String
  ananWorkspaceId    String
  ananOrganizationId String
  grantedScopes      String[]
  status             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  app PartnerApp @relation(fields: [partnerAppId], references: [id], onDelete: Cascade)

  @@index([partnerAppId])
  @@index([ananWorkspaceId])
  @@index([status])
}

model AnanIntegrationEvent {
  id             String   @id @default(cuid())
  direction      String
  contract       String
  idempotencyKey String   @unique
  status         String
  attempts       Int      @default(0)
  payload        Json
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([contract])
}
