{
  "compilerOptions": {
    "baseUrl": "../..",
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "typeRoots": ["../../node_modules/@types"],
    "types": ["react", "react-dom", "node"],
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@convex/*": ["convex/_generated/*"],
      "@convex/api": ["convex/_generated/api.d.ts"],
      "@qentrah/ag-ui": ["packages/ag-ui/src/index.ts"],
      "@qentrah/ag-ui/react": ["packages/ag-ui/src/react/index.ts"]
    }
  },
  "include": [
    "src/protocol/**/*.ts",
    "src/cards/**/*.tsx",
    "src/cards/**/*.ts",
    "src/react/**/*.tsx",
    "src/react/**/*.ts",
    "src/index.ts"
  ],
  "exclude": ["node_modules", "examples/**/*", "**/*.test.ts", "**/*.test.tsx"]
}
