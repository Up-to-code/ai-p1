{
  "name": "@qentrah/ui",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "Shared Qentrah React UI primitives for apps.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "import": "./dist/chat/index.js"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "import": "./dist/forms/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.js"
    },
    "./public": {
      "types": "./dist/public/index.d.ts",
      "import": "./dist/public/index.js"
    },
    "./qentrah-table": {
      "types": "./dist/qentrah-table/index.d.ts",
      "import": "./dist/qentrah-table/index.js"
    },
    "./button": {
      "types": "./dist/components/ui/button.d.ts",
      "import": "./dist/components/ui/button.js"
    },
    "./dropdown-menu": {
      "types": "./dist/components/ui/dropdown-menu.d.ts",
      "import": "./dist/components/ui/dropdown-menu.js"
    }
  },
  "scripts": {
    "prebuild": "npm --workspace @qentrah/brand-identity run build && npm --workspace @qentrah/platform-core run build && npm --workspace @qentrah/auth run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@qentrah/auth": "0.1.0",
    "@qentrah/platform-core": "0.1.0",
    "ag-grid-community": "^33.3.2",
    "ag-grid-react": "^33.3.2",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.5",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "use-stick-to-bottom": "^1.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
