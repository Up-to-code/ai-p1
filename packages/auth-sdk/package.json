{
  "name": "@qentrah/auth-sdk",
  "version": "0.1.7",
  "description": "Public Qentrah partner authorization SDK for OAuth, webhooks, and service-app API calls.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authorization": {
      "types": "./dist/authorization/index.d.ts",
      "import": "./dist/authorization/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./oidc": {
      "types": "./dist/oidc/index.d.ts",
      "import": "./dist/oidc/index.js"
    },
    "./partner": {
      "types": "./dist/partner/index.d.ts",
      "import": "./dist/partner/index.js"
    },
    "./partner/browser": {
      "types": "./dist/partner/browser/index.d.ts",
      "import": "./dist/partner/browser/index.js"
    },
    "./partner/next": {
      "types": "./dist/partner/next/index.d.ts",
      "import": "./dist/partner/next/index.js"
    },
    "./partner/service-app": {
      "types": "./dist/partner/service-app/index.d.ts",
      "import": "./dist/partner/service-app/index.js"
    },
    "./partner/webhooks": {
      "types": "./dist/partner/webhooks/index.d.ts",
      "import": "./dist/partner/webhooks/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./qentrah-auth.js": "./dist/qentrah-auth.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-browser-bundle.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run test && npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
