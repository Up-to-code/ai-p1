{
  "name": "@qentrah/domain-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Qentrah DTOs, Zod schemas, and server contract types.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./subscription-pricing": {
      "types": "./dist/subscriptionPricing.d.ts",
      "import": "./dist/subscriptionPricing.js"
    }
  },
  "scripts": {
    "prebuild": "npm --workspace @qentrah/platform-core run build && npm --workspace @qentrah/auth run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@qentrah/auth": "0.1.0",
    "@qentrah/platform-core": "0.1.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "convex": "^1.31.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "convex": "^1.31.6",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
