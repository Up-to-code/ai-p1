{
  "name": "@qentrah/workspace-logic",
  "version": "0.1.0",
  "description": "Pure workspace zone and capability logic for Qentrah.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zones": {
      "types": "./dist/zones.d.ts",
      "import": "./dist/zones.js"
    }
  },
  "scripts": {
    "prebuild": "npm --workspace @qentrah/domain-contracts run build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@qentrah/domain-contracts": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
