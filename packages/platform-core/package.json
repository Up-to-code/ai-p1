{
  "name": "@anan/platform-core",
  "version": "0.1.0",
  "description": "Shared Anan platform primitives for auth, session contracts, errors, locale, and app adapters.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth-next": {
      "types": "./dist/auth-next.d.ts",
      "import": "./dist/auth-next.js"
    },
    "./classnames": {
      "types": "./dist/classnames.d.ts",
      "import": "./dist/classnames.js"
    },
    "./convex-api": {
      "types": "./dist/convex-api.d.ts",
      "import": "./dist/convex-api.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.11.4",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "convex": "^1.31.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "convex": "^1.31.6",
    "typescript": "^5",
    "vitest": "^2.0.0"
  }
}
