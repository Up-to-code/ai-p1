{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,convex -c cyan,magenta \"next dev\" \"convex dev\"",
    "dev:stack": "concurrently -k -n next,convex -c cyan,magenta \"next dev\" \"convex dev\"",
    "dev:stop": "node scripts/dev-stop.mjs",
    "dev:next": "next dev",
    "dev:hono": "next dev",
    "dev:convex": "convex dev",
    "dev:convex:once": "convex dev --once",
    "codegen:convex": "convex codegen",
    "build": "next build && node scripts/ensure-vercel-manifest.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
