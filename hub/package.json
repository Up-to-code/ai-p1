    "@uploadthing/react": "^7.3.3",
    "better-auth": "~1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.37.0",
    "convex-helpers": "^0.1.116",
    "framer-motion": "^12.38.0",
    "hono": "^4.12.18",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.3",
    "next": "16.2.4",
    "next-intl": "^4.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
