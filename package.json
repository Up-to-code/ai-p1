{
  "name": "qentrah",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:ws": "npm --workspace @qentrah/workspace run dev",
    "dev:workspace:desktop": "npm --workspace @qentrah/workspace run desktop:dev",
    "build:workspace:desktop": "npm --workspace @qentrah/workspace run desktop:pack",
    "dist:workspace:desktop": "npm --workspace @qentrah/workspace run desktop:dist",
    "dev:partners": "npm --workspace @qentrah/partners run dev",
    "dev:admin": "npm --workspace @qentrah/admin-review run dev",
    "dev:demo": "npm --workspace @qentrah/demo-partner-app run dev",
    "dev:marketing": "npm --workspace @qentrah/marketing run dev",
    "dev:strapi": "npm --workspace @qentrah/strapi run dev",
    "build:strapi": "npm --workspace @qentrah/strapi run build",
    "seed:strapi": "npm --workspace @qentrah/strapi run seed",
    "brand:assets": "node scripts/brand-assets.mjs",
    "brand:scan": "node scripts/brand-scan.mjs",
    "brand:sync": "node scripts/brand-sync.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@expo/metro": "^55.1.1",
    "@expo/router-server": "^57.0.1",
    "anser": "^2.3.5",
    "bser": "^2.1.1",
    "chrome-launcher": "^1.2.1",
    "destroy": "^1.2.0",
    "effect": "^3.21.2",
    "getenv": "^2.0.0",
    "is-typed-array": "^1.1.15",
    "metro-transform-plugins": "^0.85.0",
    "on-headers": "^1.1.0",
    "patch-package": "^8.0.1",
    "simple-swizzle": "^0.2.4",
    "supports-hyperlinks": "^4.5.0"
  },
  "overrides": {
    "effect": "$effect",
    "postcss": "8.5.14",
    "next": "16.3.0-canary.32"
  },
  "optionalDependencies": {
    "@parcel/watcher-linux-x64-glibc": "^2.5.6",
    "@swc/core-linux-x64-gnu": "^1.15.33",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.0",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@sentry/nextjs": "^8.54.0",
    "ai": "^7.0.14",
    "eve": "^0.19.0",
    "extend": "^3.0.2",
    "is-plain-obj": "^4.1.0",
    "next": "16.3.0-canary.32",
    "obug": "^2.1.3",
    "require-in-the-middle": "^8.0.1",
    "stacktrace-parser": "^0.1.11",
    "tinyglobby": "^0.2.17"
  }
}
