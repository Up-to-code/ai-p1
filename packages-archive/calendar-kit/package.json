{
  "name": "@qentrah/calendar-kit",
  "version": "1.0.0",
  "description": "Qentrah Calendar Kit — a production-ready React scheduler with Month, Week, and Day views, built for the Qentrah platform.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types":   "./dist/index.d.ts",
      "import":  "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css"
  },
  "scripts": {
    "build":          "rollup -c",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "calendar",
    "scheduler",
    "qentrah",
    "week-view",
    "month-view",
    "day-view",
    "typescript",
    "ui-component"
  ],
  "author": "Qentrah Team <dev@qentrah.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url":  "https://github.com/Up-to-code/anan-0.1.2.git",
    "directory": "packages/calendar-kit"
  },
  "bugs": {
    "url": "https://github.com/Up-to-code/anan-0.1.2/issues"
  },
  "homepage": "https://qentrah.com",
  "peerDependencies": {
    "react":     "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx":          "^2.1.1",
    "date-fns":      "^4.1.0",
    "date-fns-tz":   "^3.2.0",
    "framer-motion": "^11.18.2",
    "lucide-react":  "^0.469.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs":    "^28.0.9",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript":  "^12.3.0",
    "@types/node":  "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rollup":                     "^4.53.3",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss":      "^4.0.2",
    "typescript": "^5.7.2"
  }
}
